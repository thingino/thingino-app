<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors thingino-dfu's activity_main.xml spine:
     header / status card / primary actions / collapsible cards / progress / log.
     Same paddings, corner radii, elevations, text sizes and button hierarchy.

     One structural difference from the DFU app: the form scrolls. This screen
     has an always-expanded Wi-Fi card on top of the collapsible one, which
     overflows a short handset once Device Settings is open. The log card is a
     sibling of that ScrollView rather than a child, so the two scroll regions
     never nest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ProvisionActivity">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_provision"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>

    <!-- Status Card: portal connection state, then camera identity from
         GET /x/api.cgi?action=get_info once we are on the AP. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_no_camera"
                android:textSize="16sp"
                android:drawablePadding="8dp" />

            <!-- hostname / IMAGE_ID, the equivalent of the DFU app's SoC line -->
            <TextView
                android:id="@+id/cameraText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/buildText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Primary actions. Filled = the happy path, tonal = the secondary one,
         same 56dp pairing as Read/Write in the DFU app. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/findButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_find"
            android:textSize="16sp"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/provisionButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_provision"
            android:textSize="16sp"
            android:enabled="false"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Wi-Fi credentials. Expanded by default: this is the one card the user
         must fill in, so it does not follow the collapsed-by-default rule. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/wifiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wifi_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <!-- Populated from action=scan_networks. That call is unreliable on
                 builds where the AP netdev is not wlan0, so the manual field
                 below is always available rather than a fallback. -->
            <Spinner
                android:id="@+id/ssidSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/ssidInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_ssid"
                android:inputType="text"
                android:importantForAutofill="no"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/passInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_pass"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/wifiWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_cleartext_warning"
                android:textSize="12sp"
                android:textColor="@color/warning" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Device settings: the tappable-header-with-chevron pattern from the DFU
         app's release/custom-bootloader cards, but expanded on open rather than
         collapsed. Hostname and root password are part of the normal path here,
         not an advanced option, so they should be in front of the user. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/deviceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/deviceHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/device_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/deviceChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textSize="16sp"
                    android:textColor="@color/on_surface_variant"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deviceBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- Prefilled from get_info. Avoid the ing-<board>-xxxx shape:
                     S04hostname treats that as auto-generated and regenerates
                     it on the next boot. -->
                <EditText
                    android:id="@+id/hostnameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/hint_hostname"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/rootPassInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_rootpass"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/pubkeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_pubkey"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:importantForAutofill="no"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/timezoneSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/device_ap_mode"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/device_ap_mode_desc"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/apModeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint"
                        app:trackDecorationTint="@color/switch_track_decoration_tint" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Post-reboot rediscovery over mDNS: browse _http._tcp and match the
         "Thingino Web UI (" name prefix that S50mdnsd generates. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/discoverButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_discover"
        android:textSize="14sp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

</LinearLayout>
</ScrollView>

    <!-- Log Output. Pinned below the scroll region, not inside it, and hidden
         until Show debug log is enabled in Settings. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logCard"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardElevation="1dp"
        app:cardCornerRadius="8dp">

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:background="@color/log_background">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorPrimary"
                android:lineSpacingExtra="2dp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
