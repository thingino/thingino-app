<?xml version="1.0" encoding="utf-8"?>
<!-- Same shape as thingino-dfu's dialog_settings.xml: 24dp side padding, bold
     section labels, a hairline divider at 20% alpha, and switch rows carrying a
     title plus a 12sp description. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Which address the portal answers on. 172.16.0.1 is an unprovisioned
         camera; 100.64.1.1 is one already running as its own access point. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_host_title"
        android:textStyle="bold"
        android:textColor="@color/on_surface" />

    <RadioGroup
        android:id="@+id/dlgHostRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/dlgRadioPortal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_host_portal" />

        <RadioButton
            android:id="@+id/dlgRadioApMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_host_ap_mode" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/on_surface_variant"
        android:alpha="0.2" />

    <!-- Reveals the monospace log pane at the foot of the main screen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_provision_debug"
                android:textColor="@color/on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_provision_debug_desc"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/dlgDebugSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_tint"
            app:trackTint="@color/switch_track_tint"
            app:trackDecorationTint="@color/switch_track_decoration_tint" />
    </LinearLayout>
</LinearLayout>
