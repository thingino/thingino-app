<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the add-network and add-root-password dialogs. The network
     wording here is a default; the caller sets the hints and the checkbox
     label for the kind being added, and hides the secret field when it already
     has the secret and only needs a name for it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/addName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="@string/hint_ssid"
        android:inputType="text"
        android:importantForAutofill="no"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/addSecret"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_pass"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/addPreferred"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/networks_prefer"
        android:textSize="12sp" />
</LinearLayout>
