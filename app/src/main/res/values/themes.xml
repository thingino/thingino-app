<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Thingino" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>
    </style>

    <!-- Button styles mirroring the web properties. The house rule there is
         solid accent for the one primary action and outline for everything
         else: image-builder's .btn-thingino is a solid #ff8c00 on #0d1117,
         and webflash is btn-outline-primary / btn-outline-secondary
         throughout. Disabled always goes flat muted grey rather than a dimmed
         accent, so it is obvious which actions are live. -->

    <!-- .btn-thingino -->
    <style name="Widget.Thingino.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_filled_bg</item>
        <item name="android:textColor">@color/btn_filled_text</item>
        <item name="strokeColor">@color/btn_filled_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">@color/on_primary</item>
    </style>

    <!-- btn-outline-secondary -->
    <style name="Widget.Thingino.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="strokeColor">@color/btn_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">@color/on_surface_variant</item>
    </style>

    <!-- btn-outline-primary / .btn-attention -->
    <style name="Widget.Thingino.Button.Outlined.Accent">
        <item name="android:textColor">@color/btn_accent_text</item>
        <item name="strokeColor">@color/btn_accent_stroke</item>
        <item name="backgroundTint">@color/btn_accent_bg</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/primary</item>
    </style>
</resources>
